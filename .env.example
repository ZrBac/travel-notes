# Copy to .env; real values must never be committed.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRAVEL_SECRET=
# Change database/role/host to match your own PostgreSQL setup.
TRAVEL_DATABASE_URL='dbname=travelnotes_dev host=/var/run/postgresql'
TRAVEL_DATA=.local-data
TRAVEL_WRITE_LOCK=.local-data/write.lock
# Set 1 only when the browser accesses the application over HTTPS.
TRAVEL_HTTPS=0
