[Unit]
Description=Lightweight Travel Notes health check
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/travel-notes
ExecStart=/opt/travel-notes/.venv/bin/python /opt/travel-notes/ops.py check
TimeoutStartSec=75
Nice=10
MemoryMax=128M
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/travel-notes-ops /var/log/nginx /run
