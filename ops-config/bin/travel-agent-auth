#!/bin/sh
# Authentication belongs only to the website agent's dedicated Unix account.
set -eu
umask 077
if [ "$(id -u)" -ne 0 ]; then
    echo '请通过管理员 SSH 运行此命令。' >&2
    exit 1
fi
case "${1:-status}" in
    login) set -- login --device-auth ;;
    browser-login) set -- login ;;
    status) set -- login status ;;
    logout) set -- logout ;;
    *) echo '用法：travel-agent-auth [login|browser-login|status|logout]' >&2; exit 2 ;;
esac
cd /var/lib/travel-agent/home
exec /usr/sbin/runuser -u travelagent -- /usr/bin/env -i \
    HOME=/var/lib/travel-agent/home \
    USER=travelagent LOGNAME=travelagent \
    PATH=/usr/local/bin:/usr/bin:/bin \
    LANG=C.UTF-8 TERM=xterm-256color \
    CODEX_HOME=/var/lib/travel-agent/home/.codex \
    /usr/local/bin/codex \
    -c 'cli_auth_credentials_store="file"' \
    -c 'forced_login_method="chatgpt"' "$@"
