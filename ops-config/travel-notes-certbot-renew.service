[Unit]
Description=Renew Travel Notes HTTPS certificates
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
ExecStart=/opt/certbot/bin/certbot renew --quiet
Environment=HOME=/var/lib/letsencrypt
UMask=0077
Nice=10
TimeoutStartSec=15min
MemoryMax=256M
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /var/www/letsencrypt /var/log/nginx /run
