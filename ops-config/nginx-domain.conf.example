server {
    listen 80;
    listen [::]:80;
    server_name travel.example.com;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://travel.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name travel.example.com;

    ssl_certificate /etc/letsencrypt/live/travel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/travel.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TravelTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    proxy_cookie_flags session secure;
    add_header Strict-Transport-Security "max-age=2592000" always;

    include /etc/nginx/default.d/ip-test.conf;
}
